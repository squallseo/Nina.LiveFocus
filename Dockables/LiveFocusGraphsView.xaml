<UserControl x:Class="Cwseo.NINA.LiveFocus.Dockables.LiveFocusGraphsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Contrib.Wpf" xmlns:wpfutil="clr-namespace:NINA.WPF.Base.Utility;assembly=NINA.WPF.Base" Foreground="{DynamicResource PrimaryBrush}" FontFamily="Segoe UI" FontSize="11">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/StaticResources/Brushes.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="FocusRoiBrush" Color="#FFD54F" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid x:Name="MeasurementsPanel" Grid.Column="0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="0" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="2*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border x:Name="HfrCard" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Width="28" Padding="5" MinHeight="24" Foreground="{StaticResource PrimaryBrush}" Background="{StaticResource ButtonBackgroundBrush}" Command="{Binding ClearLiveGraphCommand}" ToolTip="Clear the local HFR history." AutomationProperties.Name="Clear live graph">
            <Viewbox Width="13" Height="13">
              <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M 4,0 L 10,0 L 10,2 L 14,2 L 14,4 L 0,4 L 0,2 L 4,2 Z M 2,5 L 12,5 L 11,15 L 3,15 Z" />
            </Viewbox>
          </Button>
          <TextBlock Text="{Binding LiveHfrText}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,0" />
        </DockPanel>
        <oxy:Plot x:Name="PreviewFocusPlot" Grid.Row="1" PlotMargins="44,4,8,32" Background="{StaticResource BackgroundBrush}" PlotAreaBackground="{StaticResource BackgroundBrush}">
          <oxy:Plot.Axes>
            <oxy:LinearAxis Position="Bottom" Title="Time (s)" Minimum="-120" Maximum="0" IsPanEnabled="False" IsZoomEnabled="False" FontSize="10" TitleFontSize="10" StringFormat="0" MinimumPadding="0" MaximumPadding="0" TextColor="{Binding Color, Source={StaticResource PrimaryBrush}}" TitleColor="{Binding Color, Source={StaticResource PrimaryBrush}}" />
            <oxy:LinearAxis Position="Left" Title="HFR (px)" IntervalLength="28" IsPanEnabled="False" IsZoomEnabled="False" FontSize="10" TitleFontSize="10" MinimumPadding="0.08" MaximumPadding="0.08" TextColor="{Binding Color, Source={StaticResource PrimaryBrush}}" TitleColor="{Binding Color, Source={StaticResource PrimaryBrush}}" />
          </oxy:Plot.Axes>
          <oxy:Plot.Series>
            <oxy:LineSeries ItemsSource="{Binding LiveGraphPoints}" DataFieldX="X" DataFieldY="Y" Color="{Binding Color, Source={StaticResource FocusRoiBrush}}" StrokeThickness="1.5" MarkerType="Circle" MarkerSize="2" MarkerFill="{Binding Color, Source={StaticResource FocusRoiBrush}}" />
          </oxy:Plot.Series>
        </oxy:Plot>
      </Grid>
    </Border>
    <Border x:Name="ProfileCard" Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Star profile" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />
        <oxy:Plot Grid.Row="1" Background="{StaticResource BackgroundBrush}" PlotAreaBackground="{StaticResource BackgroundBrush}">
          <oxy:Plot.Axes>
            <oxy:LinearAxis Position="Bottom" Title="Distance (px)" FontSize="10" TitleFontSize="10" TextColor="{Binding Color, Source={StaticResource PrimaryBrush}}" TitleColor="{Binding Color, Source={StaticResource PrimaryBrush}}" />
            <oxy:LinearAxis Position="Left" Minimum="0" Maximum="1.1" FontSize="10" TextColor="{Binding Color, Source={StaticResource PrimaryBrush}}" />
          </oxy:Plot.Axes>
          <oxy:Plot.Series>
            <oxy:LineSeries ItemsSource="{Binding LiveStarProfile}" DataFieldX="X" DataFieldY="Y" Color="{Binding Color, Source={StaticResource PrimaryBrush}}" />
          </oxy:Plot.Series>
        </oxy:Plot>
      </Grid>
    </Border>
  </Grid>
</UserControl>
